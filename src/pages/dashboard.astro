---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

// RLS already scopes this to the caller's own live rows (FR-005).
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { count } = supabase
  ? await supabase.from("patterns").select("*", { count: "exact", head: true })
  : { count: null };
const atPatternCap = (count ?? 0) >= 3;
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-stone-200 bg-white/70 p-8 text-center text-stone-800">
      <h1 class="mb-4 text-3xl font-bold text-stone-800">Dashboard</h1>
      <p class="text-stone-600">
        Welcome, <span class="font-semibold text-stone-800">{user?.email}</span>
      </p>
      {
        atPatternCap ? (
          <p class="mt-6 text-sm text-stone-500">
            You've reached the 3-pattern limit. Delete a pattern to create another.
          </p>
        ) : (
          <a
            href="/editor/new"
            class="mt-6 inline-block rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm transition-colors hover:bg-stone-100"
          >
            New Pattern
          </a>
        )
      }
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm transition-colors hover:bg-stone-100"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
