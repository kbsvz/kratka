---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import PatternEditor from "@/components/editor/PatternEditor";
import type { PatternEditorData, PatternGrid, PatternPalette } from "@/types";

const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data } = supabase
  ? await supabase
      .from("patterns")
      .select("id, name, width, height, palette, grid")
      .eq("id", id ?? "")
      .single()
  : { data: null };

// RLS hides patterns the caller doesn't own, so "not found" and "not owned"
// both land here — same as FR-012's reopen contract, no distinction leaked.
const pattern: PatternEditorData | null = data
  ? {
      ...data,
      palette: data.palette as unknown as PatternPalette,
      grid: data.grid as unknown as PatternGrid,
    }
  : null;

// Astro.redirect() needs an early `return`, which astro-eslint-parser's
// frontmatter AST can't satisfy for @typescript-eslint/no-misused-promises
// (no enclosing function node to walk up to — crashes the linter). Setting
// the response directly is the documented equivalent without a `return`.
if (!pattern) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", "/dashboard");
}
---

{
  pattern && (
    <Layout title={pattern.name}>
      <PatternEditor client:load pattern={pattern} />
    </Layout>
  )
}
