---
import Layout from "@/layouts/Layout.astro";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Button } from "@/components/ui/button";

const error = Astro.url.searchParams.get("error");

const fieldClass =
  "border-stone-300 bg-white text-stone-800 placeholder:text-stone-400 focus-visible:ring-[oklch(0.5485_0.1061_160.41)]";
const labelClass = "mb-1 text-stone-700";
---

<Layout title="New Pattern">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-stone-200 bg-white/70 p-8 text-stone-800">
      <h1 class="mb-6 text-center text-2xl font-bold text-stone-800">New Pattern</h1>
      <form method="POST" action="/api/patterns" class="space-y-4">
        <div>
          <Label htmlFor="width" className={labelClass}>Width (20-100)</Label>
          <Input
            id="width"
            name="width"
            type="number"
            min="20"
            max="100"
            step="1"
            required
            defaultValue="50"
            className={fieldClass}
          />
        </div>
        <div>
          <Label htmlFor="height" className={labelClass}>Height (20-100)</Label>
          <Input
            id="height"
            name="height"
            type="number"
            min="20"
            max="100"
            step="1"
            required
            defaultValue="50"
            className={fieldClass}
          />
        </div>
        {error && <p class="text-sm text-red-700">{error}</p>}
        <Button type="submit" className="w-full bg-[oklch(0.5485_0.1061_160.41)] text-white hover:bg-[oklch(0.6085_0.1061_160.41)]">Create pattern</Button>
      </form>
      <p class="mt-4 text-center text-sm text-stone-600">
        <a href="/dashboard" class="text-[oklch(0.5485_0.1061_160.41)] hover:underline">Back to dashboard</a>
      </p>
    </div>
  </div>
</Layout>
