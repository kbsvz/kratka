---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import AppHeader from "@/components/AppHeader.astro";
import PatternDashboard from "@/components/patterns/PatternDashboard";
import type { PatternListItem } from "@/types";

const { user } = Astro.locals;

// RLS already scopes this to the caller's own live rows (FR-005); the
// patterns_select policy filters deleted_at is null, so no extra predicate
// is needed. One query now covers both the pattern list (FR-011) and the
// 3-pattern cap check, replacing the old count-only query.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data } = supabase
  ? await supabase
      .from("patterns")
      .select("id, name, width, height, updated_at")
      .order("updated_at", { ascending: false })
  : { data: null };
const patterns: PatternListItem[] = data ?? [];
const createError = Astro.url.searchParams.get("error") ?? undefined;
---

<Layout title="My Patterns">
  <div class="bg-kratka-bg min-h-screen">
    <AppHeader email={user?.email ?? ""} />
    <main class="mx-auto max-w-5xl px-8 py-14">
      <PatternDashboard client:load initialPatterns={patterns} createError={createError} />
    </main>
  </div>
</Layout>
