---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import Topbar from "@/components/Topbar.astro";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-4">
    <Topbar />
    <div class="w-full max-w-sm rounded-2xl border border-stone-200 bg-white/70 p-8 text-stone-800">
      <h1 class="mb-6 text-center text-2xl font-bold text-stone-800">Sign in</h1>
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-stone-600">
        Don't have an account? <a href="/auth/signup" class="text-kratka-green hover:underline">Sign up</a>
      </p>
    </div>
  </div>
</Layout>
