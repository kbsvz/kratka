---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getPatternForOwner } from "@/lib/patternQueries";
import AppHeader from "@/components/AppHeader.astro";
import PatternEditor from "@/components/editor/PatternEditor";
import type { PatternEditorData } from "@/types";

const { id } = Astro.params;
const { user } = Astro.locals;

// A pattern id is always a DB-generated uuid. Anything else (e.g. "new", a
// leftover bookmark from the deleted /editor/new page — this route lived at
// /editor/[id] before being renamed to /patterns/[id]) was never a real
// pattern id, so it's a genuine 404 rather than a "not found or not owned"
// case — no need to spend a query on input that can't possibly match.
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const isWellFormedId = !!id && UUID_RE.test(id);

const supabase = isWellFormedId ? createClient(Astro.request.headers, Astro.cookies) : null;

// RLS hides patterns the caller doesn't own, so "not found" and "not owned"
// both land here — same as FR-012's reopen contract, no distinction leaked.
const pattern: PatternEditorData | null = supabase ? await getPatternForOwner(supabase, id ?? "") : null;

// Astro.redirect() needs an early `return`, which astro-eslint-parser's
// frontmatter AST can't satisfy for @typescript-eslint/no-misused-promises
// (no enclosing function node to walk up to — crashes the linter). Setting
// the response directly is the documented equivalent without a `return`.
if (!pattern) {
  if (isWellFormedId) {
    Astro.response.status = 302;
    Astro.response.headers.set("Location", "/patterns");
  } else {
    Astro.response.status = 404;
  }
}
---

{
  pattern && (
    <Layout title={pattern.name}>
      <div class="flex h-screen flex-col overflow-hidden">
        <AppHeader email={user?.email ?? ""} />
        <PatternEditor client:load pattern={pattern} />
      </div>
    </Layout>
  )
}
