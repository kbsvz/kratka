---
const { user } = Astro.locals;
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-stone-200 bg-white/60 px-4 py-2 text-sm text-stone-700"
>
  {
    user ? (
      <>
        <span class="text-stone-600">{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="text-purple-700 transition-colors hover:text-purple-900 hover:underline">
            Dashboard
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-purple-700 transition-colors hover:text-purple-900 hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-stone-600">Not signed in</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-purple-700 transition-colors hover:text-purple-900 hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-purple-700 transition-colors hover:text-purple-900 hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
