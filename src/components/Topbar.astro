---
interface Props {
  class?: string;
}

const { class: className = "py-16" } = Astro.props;
---

<div class:list={`mx-auto flex max-w-4xl flex-col items-center px-4 text-center ${className}`}>
  <h1 class="mb-6 text-6xl font-bold text-stone-800 sm:text-7xl">
    <a href="/" class="hover:opacity-80">KRATKA</a>
  </h1>
  <p class="mt-1 mb-10 text-sm text-stone-600 sm:text-base">A friendly editor for designing patterns on a grid.</p>
</div>
